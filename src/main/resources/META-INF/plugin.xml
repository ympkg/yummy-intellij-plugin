<idea-plugin>
    <id>com.ympkg.idea</id>
    <name>Yummy</name>
    <vendor email="ympkg@users.noreply.github.com" url="https://github.com/ympkg/yummy">ympkg</vendor>

    <description><![CDATA[
    IntelliJ IDEA integration for the Yummy (ym) Java build tool.
    <ul>
      <li>External System integration: auto-detect package.toml and sync project model</li>
      <li>"Load Yummy Changes" notification on package.toml edits</li>
      <li>Run ym commands from IDE (Build/Dev/Test/Clean)</li>
      <li>Run Configurations for ym dev/build/test</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.externalSystem</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- External System integration (replaces directoryProjectConfigurator + editorNotificationProvider) -->
        <externalSystemManager
                implementation="com.ympkg.idea.YummyExternalSystemManager"/>

        <!-- Tool window for ym commands -->
        <toolWindow id="Yummy"
                    anchor="bottom"
                    factoryClass="com.ympkg.idea.YummyToolWindowFactory"
                    icon="/icons/ym.svg"/>

        <!-- Run configuration -->
        <configurationType
                implementation="com.ympkg.idea.run.YummyConfigurationType"/>
        <runConfigurationProducer
                implementation="com.ympkg.idea.run.YummyRunConfigurationProducer"/>
    </extensions>

    <actions>
        <group id="Yummy.Actions" text="Yummy" description="Yummy build tool actions">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Yummy.Build" class="com.ympkg.idea.actions.BuildAction"
                    text="Build" description="Run ym build"/>
            <action id="Yummy.Dev" class="com.ympkg.idea.actions.DevAction"
                    text="Dev" description="Run ym dev"/>
            <action id="Yummy.Test" class="com.ympkg.idea.actions.TestAction"
                    text="Test" description="Run ym test"/>
            <action id="Yummy.Refresh" class="com.ympkg.idea.actions.RefreshAction"
                    text="Refresh Project" description="Re-run ym idea to sync dependencies"/>
        </group>
    </actions>
</idea-plugin>
